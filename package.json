{
  "name": "falatina",
  "version": "1.0.0",
  "description": "Gráfico de mensagens semanais do grupo Fala Tina no WhatsApp — estética Liquid Glass com física de refração.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:full": "npm run typecheck && npm run lint && npm run test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{html,css,json,md}": "prettier --write"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hlucas13/fala-tina.git"
  },
  "keywords": [
    "whatsapp",
    "chart",
    "liquid-glass",
    "github-pages"
  ],
  "author": "Homero Lucas do Prado",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hlucas13/fala-tina/issues"
  },
  "homepage": "https://hlucas13.github.io/fala-tina/",
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^10.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  }
}
